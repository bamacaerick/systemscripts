{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "80rem"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "name": "Primary 50", "slug": "primary-50", "color": "#EFF6FF" },
        { "name": "Primary 100", "slug": "primary-100", "color": "#DBEAFE" },
        { "name": "Primary", "slug": "primary", "color": "#1D4ED8" },
        { "name": "Primary 600", "slug": "primary-600", "color": "#1E40AF" },
        { "name": "Primary 700", "slug": "primary-700", "color": "#1E3A8A" },
        { "name": "Secondary 50", "slug": "secondary-50", "color": "#FFF7ED" },
        { "name": "Secondary 100", "slug": "secondary-100", "color": "#FFEDD5" },
        { "name": "Secondary", "slug": "secondary", "color": "#B45309" },
        { "name": "Secondary 600", "slug": "secondary-600", "color": "#9A3412" },
        { "name": "Secondary 700", "slug": "secondary-700", "color": "#7C2D12" },
        {
          "name": "Dark",
          "slug": "dark",
          "color": "#18181B"
        },
        {
          "name": "Muted",
          "slug": "muted",
          "color": "#52525B"
        },
        {
          "name": "Border",
          "slug": "border",
          "color": "#71717A"
        },
        {
          "name": "Light",
          "slug": "light",
          "color": "#F4F4F5"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#FFFFFF"
        }
      ]
    },
    "typography": {
      "fluid": false,
      "fontFamilies": [
        {
          "name": "Sans",
          "slug": "sans",
          "fontFamily": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "name": "Serif",
          "slug": "serif",
          "fontFamily": "ui-serif, Georgia, Cambria, \"Times New Roman\", Times, serif"
        },
        {
          "name": "Mono",
          "slug": "mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
        }
      ],
      "fontSizes": [
        { "name": "Hero", "slug": "hero", "size": "clamp(2.75rem, 6vw, 4.75rem)" },
        { "name": "Heading 1", "slug": "h-1", "size": "clamp(2.25rem, 4vw, 3rem)" },
        { "name": "Heading 2", "slug": "h-2", "size": "clamp(1.875rem, 3vw, 2.25rem)" },
        { "name": "Heading 3", "slug": "h-3", "size": "1.875rem" },
        { "name": "Heading 4", "slug": "h-4", "size": "1.5rem" },
        { "name": "Heading 5", "slug": "h-5", "size": "1.25rem" },
        { "name": "Heading 6", "slug": "h-6", "size": "1rem" },
        { "name": "Legal", "slug": "legal", "size": "0.75rem" },
        {
          "name": "Extra Small",
          "slug": "xs",
          "size": "0.75rem"
        },
        {
          "name": "Small",
          "slug": "sm",
          "size": "0.875rem"
        },
        {
          "name": "Base",
          "slug": "base",
          "size": "1rem"
        },
        {
          "name": "Large",
          "slug": "lg",
          "size": "1.125rem"
        },
        {
          "name": "Extra Large",
          "slug": "xl",
          "size": "1.25rem"
        },
        {
          "name": "2XL",
          "slug": "2xl",
          "size": "1.5rem"
        },
        {
          "name": "3XL",
          "slug": "3xl",
          "size": "1.875rem"
        },
        {
          "name": "4XL",
          "slug": "4xl",
          "size": "2.25rem"
        },
        {
          "name": "5XL",
          "slug": "5xl",
          "size": "3rem"
        },
        {
          "name": "6XL",
          "slug": "6xl",
          "size": "3.75rem"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "name": "1",
          "slug": "10",
          "size": "0.5rem"
        },
        {
          "name": "2",
          "slug": "20",
          "size": "1rem"
        },
        {
          "name": "3",
          "slug": "30",
          "size": "1.5rem"
        },
        {
          "name": "4",
          "slug": "40",
          "size": "2rem"
        },
        {
          "name": "5",
          "slug": "50",
          "size": "3rem"
        },
        {
          "name": "6",
          "slug": "60",
          "size": "4rem"
        },
        {
          "name": "7",
          "slug": "70",
          "size": "6rem"
        }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Small",
          "slug": "sm",
          "shadow": "0 1px 2px 0 rgb(0 0 0 / 0.08)"
        },
        {
          "name": "Medium",
          "slug": "md",
          "shadow": "0 4px 12px -2px rgb(0 0 0 / 0.12)"
        }
      ]
    },
    "custom": {
      "radius": {
        "sm": "0.375rem",
        "md": "0.75rem",
        "lg": "1.5rem",
        "full": "9999px"
      }
    }
  }
}
