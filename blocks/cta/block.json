{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ss/cta",
  "title": "Call to action",
  "category": "ss",
  "icon": "megaphone",
  "description": "A short message with a button.",
  "textdomain": "systemscripts",
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "render": "file:./render.php",
  "ss": {
    "fields": [
      { "name": "heading", "label": "Heading", "type": "text" },
      { "name": "level", "label": "Heading level", "type": "select", "default": "h2",
        "options": [ { "label": "H2", "value": "h2" }, { "label": "H3", "value": "h3" }, { "label": "H4", "value": "h4" } ] },
      { "name": "text", "label": "Text", "type": "textarea" },
      { "name": "buttonLabel", "label": "Button label", "type": "text" },
      { "name": "buttonUrl", "label": "Button URL", "type": "url" },
      { "name": "buttonAppearance", "label": "Appearance", "type": "select", "default": "primary", "options": [ { "label": "Button", "value": "primary" }, { "label": "Secondary button", "value": "secondary" }, { "label": "Text link", "value": "link" } ] },
      { "name": "buttonNewTab", "label": "Open link in a new tab", "type": "toggle", "default": false },
      { "name": "buttonWhatsappText", "label": "WhatsApp default message (for WhatsApp URLs)", "type": "text" },
      { "name": "buttonIcon", "label": "Icon", "type": "select", "default": "none", "options": [ { "label": "None", "value": "none" }, { "label": "Arrow left", "value": "arrow-left" }, { "label": "Arrow right", "value": "arrow-right" }, { "label": "External link", "value": "external" }, { "label": "WhatsApp", "value": "whatsapp" } ] },
      { "name": "style", "label": "Background", "type": "select", "default": "primary",
        "options": [ { "label": "Primary", "value": "primary" }, { "label": "Dark", "value": "dark" }, { "label": "Light", "value": "light" } ] }
    ]
  }
}
