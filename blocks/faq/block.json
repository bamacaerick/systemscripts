{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ss/faq",
  "title": "FAQ",
  "category": "ss",
  "icon": "editor-help",
  "description": "Frequently asked questions. Also outputs FAQPage structured data.",
  "textdomain": "systemscripts",
  "supports": { "align": ["wide"], "anchor": true, "html": false },
  "render": "file:./render.php",
  "ss": {
    "fields": [
      { "name": "heading", "label": "Heading (optional)", "type": "text" },
      { "name": "level", "label": "Heading level", "type": "select", "default": "h2",
        "options": [ { "label": "H2", "value": "h2" }, { "label": "H3", "value": "h3" } ] },
      { "name": "items", "label": "Questions", "type": "repeater", "itemLabel": "Question",
        "fields": [
          { "name": "question", "label": "Question", "type": "text" },
          { "name": "answer", "label": "Answer", "type": "textarea" }
        ] }
    ]
  }
}
