{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "systemscripts/systemscripts",
    "description": "SystemScripts base WordPress theme with Tailwind CSS and Vite.",
    "type": "wordpress-theme",
    "license": "MIT",
    "authors": [
        {
            "name": "SystemScripts Team",
            "email": "bamacaerick@gmail.com",
            "homepage": "https://www.linkedin.com/in/bamacaerick/"
        }
    ],
    "autoload": {
        "psr-4": {
            "SystemScripts\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "i18n": "wp i18n make-pot . languages/systemscripts.pot --slug=systemscripts --domain=systemscripts --exclude=node_modules,dist,vendor,resources --skip-js"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
