<?xml version="1.0"?>
<ruleset name="SystemScripts">
    <description>WordPress coding standards for the SystemScripts theme.</description>
    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <config name="testVersion" value="8.1-"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array"><element value="systemscripts"/></property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array"><element value="ss"/><element value="SystemScripts"/></property>
        </properties>
    </rule>
</ruleset>
