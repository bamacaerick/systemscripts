<?xml version="1.0"?>
<ruleset name="SystemScripts">
    <description>
        Correctness and security rules from the WordPress Coding Standards.
        Formatting sniffs (tabs, spacing, Yoda) are intentionally not enforced: the code follows
        PSR-12 style, see .editorconfig.
    </description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="Generic.PHP.Syntax"/>
    <rule ref="Generic.PHP.ForbiddenFunctions"/>

    <!-- Escaping, nonces and input handling. -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DeprecatedClasses"/>
    <rule ref="WordPress.WP.DeprecatedParameters"/>

    <!-- Internationalization. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="systemscripts"/>
            </property>
        </properties>
    </rule>

    <!-- PrefixAllGlobals is not enabled: the sniff rejects prefixes shorter than 3 characters and the
         project deliberately uses "ss". Everything else is namespaced under SystemScripts. -->
</ruleset>
